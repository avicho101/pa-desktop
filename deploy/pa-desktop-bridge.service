[Unit]
Description=pa-desktop-bridge: HTTP+SSE bridge to prime-agent daemon
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/pa-desktop/bridge
# Point PA_DESKTOP_HARNESS at your prime-agent build if not at the default path.
Environment=PA_DESKTOP_HARNESS=/home/ubuntu/prime-agent/packages/coding-agent/dist/index.js
Environment=HOST=100.77.132.68
Environment=PORT=8788
ExecStart=/home/ubuntu/.nvm/versions/node/v24.18.0/bin/node /home/ubuntu/pa-desktop/bridge/server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
